{
    "name": "church-frontend",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown",
        "*.{js,ts,vue}": [
            "eslint --fix"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@nuxt/eslint": "^1.15.2",
        "@nuxt/image": "^2.0.0",
        "@nuxt/ui": "^4.8.2",
        "@payloadcms/richtext-lexical": "^3.85.1",
        "@pinia/nuxt": "^0.11.3",
        "@types/node": "^25.9.1",
        "eslint": "^10.4.0",
        "nuxt": "^4.4.6",
        "payload-lexical-nuxt-serializer": "^1.0.3",
        "pinia": "^3.0.4",
        "tailwindcss": "^4.3.1",
        "vue": "^3.5.34",
        "vue-router": "^5.0.7"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.113",
        "@nuxtjs/tailwindcss": "^6.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "prettier": "3.8.3",
        "typescript": "^6.0.3",
        "vue-tsc": "^3.3.0"
    }
}
